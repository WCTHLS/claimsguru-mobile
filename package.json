{
  "name": "claimsguru-mobile",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "private": true,
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android": "cd android && ./gradlew bundleRelease",
    "build:ios": "cd ios && pod install && xcodebuild -workspace ClaimsGuru.xcworkspace -scheme ClaimsGuru archive"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.10.1",
    "expo": "^57.0.0",
    "expo-document-picker": "^57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-image-picker": "^57.0.16",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^0.395.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "^19.0.0",
    "typescript": "^5.9.3"
  }
