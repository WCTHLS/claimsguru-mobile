{
  "name": "claimsguru-mobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android": "cd android && ./gradlew bundleRelease",
    "build:ios": "cd ios && pod install && xcodebuild -workspace ClaimsGuru.xcworkspace -scheme ClaimsGuru archive"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "@react-navigation/bottom-tabs": "^6.6.1",
