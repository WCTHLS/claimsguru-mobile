# ==============================================================================
# ClaimsGuru Mobile Environment Configuration
# ==============================================================================
# Copy this file to .env in the root of claimsguru-mobile:
#   copy .env.example .env
#
# NOTE: In Expo / React Native, environment variables exposed to the client app
# MUST be prefixed with EXPO_PUBLIC_
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Authentication Provider Configuration
# ------------------------------------------------------------------------------
# Set to 'true' to enable Microsoft Entra External ID (CIAM) authentication.
# By default, keep it 'false' for local MSSQL username + password authentication.
EXPO_PUBLIC_ENABLE_ENTRA_ID=false

# ------------------------------------------------------------------------------
# 2. Backend API Base URL (ClaimsGuru Backend)
# ------------------------------------------------------------------------------
# Default development URLs:
# - iOS Simulator / Web: http://localhost:8000
# - Android Emulator:    http://10.0.2.2:8000
# - Physical Mobile Device: http://<YOUR_COMPUTER_LAN_IP>:8000 (e.g. http://192.168.1.5:8000)
EXPO_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 3. Microsoft Entra External ID (CIAM) - Required only if EXPO_PUBLIC_ENABLE_ENTRA_ID=true
# ------------------------------------------------------------------------------
# Application (client) ID for the Patient application registered in Entra CIAM
EXPO_PUBLIC_ENTRA_PATIENT_CLIENT_ID=
EXPO_PUBLIC_ENTRA_CLIENT_ID=

# Directory (tenant) ID of your Microsoft Entra CIAM external tenant
EXPO_PUBLIC_ENTRA_TENANT_ID=

# Subdomain prefix for your external tenant (e.g., if domain is claimsguru.ciamlogin.com, enter 'claimsguru')
EXPO_PUBLIC_ENTRA_SUBDOMAIN=claimsguru

# Base authority URL (leave blank to auto-compute from SUBDOMAIN and TENANT_ID)
# Format: https://<subdomain>.ciamlogin.com/<tenantId>
EXPO_PUBLIC_ENTRA_AUTHORITY=

# Authentication redirect URI (Deep link registered in Entra CIAM & app.json)
EXPO_PUBLIC_ENTRA_REDIRECT_URI=claimsguru://auth/callback

# OpenID Connect Scopes
EXPO_PUBLIC_ENTRA_SCOPES=openid profile email offline_access
